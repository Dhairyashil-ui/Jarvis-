{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ui-universe.dev/schemas/component.schema.json",
  "title": "UIUniverseComponent",
  "description": "Normalized metadata schema for UI components, primitives, and effects in UI Universe",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "category",
    "description",
    "sourceRepository",
    "license",
    "framework",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(component|effect|primitive)\\.[a-z0-9_-]+\\.[a-z0-9_-]+\\.v[0-9]+$",
      "description": "Deterministic stable unique identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["component", "effect", "primitive", "3d", "shader"]
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceRepository": {
      "type": "string"
    },
    "originalSourcePath": {
      "type": "string"
    },
    "sourceVersion": {
      "type": "string"
    },
    "license": {
      "type": "object",
      "required": ["id", "verified", "commercialUsePermitted"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "verified": { "type": "boolean" },
        "attributionRequired": { "type": "boolean" },
        "commercialUsePermitted": { "type": "boolean" }
      }
    },
    "attribution": {
      "type": "string"
    },
    "implementationEntryPoint": {
      "type": "string"
    },
    "framework": {
      "type": "string",
      "enum": ["react", "vanilla", "nextjs", "webgl", "css", "html"]
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" },
          "default": {},
          "required": { "type": "boolean" }
        }
      }
    },
    "slots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supportedBreakpoints": {
      "type": "array",
      "items": { "type": "string", "enum": ["xs", "sm", "md", "lg", "xl", "2xl"] }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "ariaCompliant": { "type": "boolean" },
        "keyboardNavigable": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "compatibleComponents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "previewUrl": {
      "type": "string"
    },
    "previewCode": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["verified", "adapted", "reference", "unverified"]
    },
    "validationStatus": {
      "type": "string",
      "enum": ["valid", "warning", "error"]
    },
    "lastVerified": {
      "type": "string"
    }
  }
}
