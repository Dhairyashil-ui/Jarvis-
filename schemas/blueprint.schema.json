{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ui-universe.dev/schemas/blueprint.schema.json",
  "title": "UIUniverseAIBlueprint",
  "description": "Validated machine-readable declarative blueprint format for AI website assembly without code generation",
  "type": "object",
  "required": ["version", "theme", "pages"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0", "1.1", "2.0"]
    },
    "template": {
      "type": "string",
      "description": "Optional base template ID"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "targetIndustry": { "type": "string" },
        "generatedAt": { "type": "string" },
        "generatedBy": { "type": "string" }
      }
    },
    "theme": {
      "type": ["string", "object"],
      "description": "Preset theme key (e.g. 'midnight_cinematic', 'minimal_light', 'cyber_neon') or custom token definition",
      "properties": {
        "mode": { "type": "string", "enum": ["dark", "light", "system"] },
        "palette": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "accent": { "type": "string" },
            "background": { "type": "string" },
            "surface": { "type": "string" },
            "text": { "type": "string" },
            "mutedText": { "type": "string" },
            "border": { "type": "string" }
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "headingFont": { "type": "string" },
            "bodyFont": { "type": "string" },
            "monoFont": { "type": "string" }
          }
        },
        "radius": { "type": "string" },
        "stylePreset": { "type": "string" }
      }
    },
    "navigation": {
      "type": "object",
      "properties": {
        "brand": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "logoUrl": { "type": "string" },
            "homeUrl": { "type": "string" }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "href"],
            "properties": {
              "label": { "type": "string" },
              "href": { "type": "string" },
              "isExternal": { "type": "boolean" },
              "badge": { "type": "string" }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "href"],
            "properties": {
              "label": { "type": "string" },
              "href": { "type": "string" },
              "variant": { "type": "string", "enum": ["primary", "secondary", "ghost", "shimmer"] }
            }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sections"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "title": { "type": "string" },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "component"],
              "properties": {
                "id": { "type": "string" },
                "component": {
                  "type": "string",
                  "description": "Registry identifier of section or component"
                },
                "props": {
                  "type": "object",
                  "description": "Strict JSON props with primitive values or plain objects; no executable code allowed"
                },
                "slots": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["component"],
                      "properties": {
                        "id": { "type": "string" },
                        "component": { "type": "string" },
                        "props": { "type": "object" }
                      }
                    }
                  }
                },
                "animation": {
                  "type": "object",
                  "properties": {
                    "preset": { "type": "string", "enum": ["fade_up", "blur_reveal", "scale_in", "slide_lateral", "3d_tilt", "float", "none"] },
                    "duration": { "type": "number" },
                    "delay": { "type": "number" },
                    "trigger": { "type": "string", "enum": ["scroll", "load", "hover"] }
                  }
                },
                "responsive": {
                  "type": "object",
                  "properties": {
                    "hiddenOn": {
                      "type": "array",
                      "items": { "type": "string", "enum": ["mobile", "tablet", "desktop"] }
                    },
                    "columns": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "properties": {
        "copyright": { "type": "string" },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": { "type": "string" },
                    "href": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
